<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_product_price" model="ir.module.category">
        <field name="name">Precios de Productos</field>
        <field name="description">Visibilidad del precio de venta real de los productos.</field>
        <field name="sequence">95</field>
    </record>

    <record id="privilege_product_price" model="res.groups.privilege">
        <field name="name">Precios de Productos</field>
        <field name="category_id" ref="module_category_product_price"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_product_price_viewer" model="res.groups">
        <field name="name">Ver Precio de Venta de Productos</field>
        <field name="privilege_id" ref="privilege_product_price"/>
        <field name="comment">Usuarios que pueden ver el precio de venta real de los productos</field>
    </record>
</odoo>
